# ════════════════════════════════════════════════════════════════
#  TRAPERO AI — variables de entorno
#  En Vercel: Project → Settings → Environment Variables
#  (Vercel las guarda cifradas y nunca llegan al navegador)
# ════════════════════════════════════════════════════════════════

# ── Base de datos (Supabase → Connect). Si conectas Supabase desde Vercel → Storage,
#    no hace falta: se usan POSTGRES_PRISMA_URL y POSTGRES_URL_NON_POOLING automáticamente ──
# Transaction pooler (puerto 6543). Añade ?pgbouncer=true&connection_limit=1 al final
DATABASE_URL="postgresql://postgres.xxxx:CONTRASEÑA@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session pooler (puerto 5432). Se usa para crear las tablas
DIRECT_URL="postgresql://postgres.xxxx:CONTRASEÑA@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# ── Almacenamiento de archivos ──
# "supabase" en producción (Vercel no tiene disco permanente); "local" en desarrollo
STORAGE_DRIVER="supabase"
SUPABASE_URL="https://xxxx.supabase.co"
# Supabase → Project Settings → API Keys → service_role / secret (¡nunca la publiques!)
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="trapero-files"
# Solo con STORAGE_DRIVER=local
STORAGE_DIR="./storage"

# ── Seguridad ──
# Opcional: mínimo 32 caracteres aleatorios. Si falta, se deriva de la clave de Supabase
AUTH_SECRET=""
# Código que se pide en /setup para crear el primer administrador
SETUP_CODE=""
SESSION_HOURS=12

# ── Proveedores de IA (rellena los que tengas; los vacíos se ignoran) ──
# Gratuitos
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
# De pago (se activan solos al poner la clave)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
