# ── Base de datos ──────────────────────────────────────────────
# Desarrollo: SQLite. Producción: cambia el provider en prisma/schema.prisma a "postgresql".
DATABASE_URL="file:./trapero.db"

# ── Seguridad ─────────────────────────────────────────────────
# Genera uno con:  openssl rand -base64 48
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
# Duración de la sesión en horas
SESSION_HOURS=12

# ── Administrador inicial (solo se usa en el seed) ────────────
ADMIN_EMAIL="admin@ejemplo.com"
ADMIN_NAME="Administrador"
ADMIN_PASSWORD="cambia-esta-contraseña"

# ── Proveedores de IA (solo servidor, nunca se envían al navegador) ──
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# ── Almacenamiento de archivos ────────────────────────────────
STORAGE_DIR="./storage"
